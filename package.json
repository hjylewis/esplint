{
  "name": "esplint",
  "version": "0.11.0",
  "description": "A ESLint warning tracker to help introduce rules into a legacy code base",
  "bin": "index.js",
  "engines": {
    "node": ">=14"
  },
  "scripts": {
    "release": "standard-version --commit-all",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hjylewis/esplint.git"
  },
  "keywords": [
    "eslint",
    "javascript",
    "linter"
  ],
  "author": "hjylewis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hjylewis/esplint/issues"
  },
  "homepage": "https://github.com/hjylewis/esplint#readme",
  "devDependencies": {
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.0.0",
    "execa": "^5.0.0",
    "cross-env": "^7.0.3",
    "husky": "^7.0.4",
    "jest": "^29.7.0",
    "lint-staged": "^13.2.1",
    "prettier": "^2.6.0",
    "standard-version": "^9.3.2",
    "strip-ansi": "^6.0.0"
  },
  "peerDependencies": {
    "eslint": "^7.0.0 || ^8.0.0 || ^9.0.0"
  },
  "dependencies": {
    "chalk": "^4.0.0",
    "cosmiconfig": "^8.1.3",
    "figures": "^3.0.0",
    "lodash": "^4.17.21",
    "object-hash": "^3.0.0",
    "pkg-dir": "^5.0.0",
    "semver": "^7.3.5",
    "simple-git": "^3.4.0",
    "yargs": "^17.4.0"
  }
}
